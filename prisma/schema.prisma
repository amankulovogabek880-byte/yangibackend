// ═══════════════════════════════════════════════════════════════
// JARVIS BOT — v41: har bir tenant uchun ALOHIDA ICHKI Telegram bot
// ═══════════════════════════════════════════════════════════════
//
// MAQSAD: mijozlar bilan gaplashadigan `TelegramAccount` botlaridan
// TAMOMILA FARQLI — bu faqat CRM XODIMLARI uchun ICHKI bot:
//   1) Har bir qo'ng'iroq AI tahlili tugagach — ADMINGA yuboriladi.
//   2) Har kuni ertalab har bir AGENTGA shaxsiy AI brifing, ADMINGA
//      esa jamoaviy brifing yuboriladi (BriefingService orqali,
//      keshlangan — qo'shimcha AI xarajat qilmaydi).
//   3) Faqat ADMIN (TENANT_ADMIN/MANAGER) botga to'g'ridan-to'g'ri
//      savol yozib Jarvis (tool-use AI yordamchi)dan javob olishi
//      mumkin — oddiy AGENT faqat bildirishnoma oladi, yozolmaydi.
//
// IZOLYATSIYA: bitta tenantning boti FAQAT o'zining tenantId'siga
// tegishli foydalanuvchilar bilan ishlaydi (`JarvisBotLink.tenantId`
// + `botId` — @@unique([botId, chatId])). Runtime'da har bir bot
// instansi yaratilgan paytdayoq FAQAT bitta tenantId bilan yopiladi
// (closure) — boshqa tenant ma'lumoti shu bot orqali HECH QACHON
// chiqib ketolmaydi, aralashib qolmaydi.
model JarvisBot {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  botToken    String
  botUsername String?
  isActive    Boolean @default(true)

  // Sozlamalar (admin CRM sozlamalaridan boshqaradi)
  notifyAdminOnAnalysis Boolean @default(true) // har bir qo'ng'iroq tahlilidan keyin adminga yuborish
  dailyDigestEnabled    Boolean @default(true) // kunlik AI brifingni botga yuborish
  dailyDigestHour       Int     @default(9)    // Asia/Tashkent bo'yicha soat (0-23)
  // Oxirgi kunlik digest yuborilgan sana (YYYY-MM-DD, Tashkent) —
  // bir kunda BIR MARTA yuborilishini kafolatlaydi (xarajat nazorati).
  lastDigestDate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links JarvisBotLink[]

  @@map("jarvis_bots")
}

model JarvisBotLink {
  id       String    @id @default(cuid())
  tenantId String
  botId    String
  bot      JarvisBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  chatId String // Telegramdagi shaxsiy chat ID (foydalanuvchi /start qilganda yoziladi)
  role   String // ulash vaqtidagi rol (TENANT_ADMIN/MANAGER/AGENT) — marshrutlash uchun

  // ADMIN botga yozgan savollarni Jarvis AI yordamchisi (ai-assistant
  // moduli) orqali javoblaydi — shu maydon suhbat davomiyligini
  // (kontekstni) Telegram orqali ham saqlab turadi.
  aiConversationId String?

  isActive Boolean  @default(true)
  linkedAt DateTime @default(now())

  @@unique([botId, chatId])
  @@index([tenantId])
  @@map("jarvis_bot_links")
}

// ═══════════════════════════════════════════════════════════════
// TURLAR BOZORI (MARKETPLACE) — v12.1
// ═══════════════════════════════════════════════════════════════
//
// Maqsad: har bir agentlik (tenant) O'ZI ishlaydigan tur operatorlarni
// qo'shadi, ularning turlari CRM ichida ko'rinadi va agent shu yerdan
// to'g'ridan-to'g'ri BOOKING qiladi.
//
// ARXITEKTURA (v12 dan farqi):
//   - TourOperator va MarketplaceTour endi TENANTGA BOG'LANGAN.
//     A kompaniyaning operatori B kompaniyaga KO'RINMAYDI.
//   - Operator soni cheklanmagan.
//   - "Bron so'rovi" (TourBookingRequest) bosqichi OLIB TASHLANDI —
//     agent turni bosib to'g'ridan-to'g'ri Booking yaratadi.
//
// XAVFSIZLIK: credLogin/credPassword/apiKey — EncryptionService orqali
// SHIFRLANGAN saqlanadi va API javobida hech qachon ochiq qaytmaydi.
// ═══════════════════════════════════════════════════════════════

enum IntegrationType {
  MANUAL // Qo'lda kiritish
  EXCEL  // Excel/CSV import
  API    // Operator API'si orqali avtomatik
}

enum TourOperatorStatus {
  ACTIVE
  INACTIVE
  ERROR // Oxirgi sinxronizatsiya xato bilan tugadi
}

enum MarketplaceTourStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TourOperator {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  logoUrl     String?

  contactPhone String?
  contactEmail String?
  website      String?

  integrationType IntegrationType @default(MANUAL)

  // ── Maxfiy ma'lumotlar (SHIFRLANGAN) ──
  apiBaseUrl   String?
  credLogin    String?
  credPassword String?
  apiKey       String?

  status        TourOperatorStatus @default(ACTIVE)
  lastSyncAt    DateTime?
  lastSyncError String?
  toursCount    Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours MarketplaceTour[]

  // Slug faqat tenant ichida takrorlanmas — turli kompaniyalar bir xil
  // nomdagi operatorni qo'shishi mumkin.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@map("tour_operators")
}

model MarketplaceTour {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  operatorId String
  operator   TourOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  // Operatorning o'z tizimidagi ID — takror import bo'lmasligi uchun
  externalId String?

  title       String
  destination String
  country     String?
  city        String?
  tourType    TourType @default(PACKAGE)
  description String?

  // BRUTTO — mijoz to'laydigan narx (1 kishi uchun)
  price     Float
  // NETTO — operatordan sotib olish narxi (1 kishi uchun).
  // Booking yaratilganda supplierCost shundan hisoblanadi va
  // foyda = totalPrice - supplierCost bo'ladi. Bo'sh bo'lsa foyda
  // hisoblanmaydi (0), lekin hisobot buzilmaydi.
  netPrice  Float?
  currency  Currency @default(USD)
  priceNote String?

  departureDate DateTime?
  returnDate    DateTime?
  duration      Int?

  seatsTotal     Int?
  seatsAvailable Int?

  hotelName  String?
  hotelStars Int?
  mealPlan   String?

  includesVisa      Boolean @default(false)
  includesFlights   Boolean @default(false)
  includesHotel     Boolean @default(false)
  includesMeals     Boolean @default(false)
  includesTransfer  Boolean @default(false)
  includesInsurance Boolean @default(false)

  images Json  @default("[]")
  raw    Json?

  status   MarketplaceTourStatus @default(PUBLISHED)
  syncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operatorId, externalId])
  @@index([tenantId])
  @@index([status])
  @@index([destination])
  @@index([country])
  @@index([departureDate])
  @@index([operatorId])
  @@map("marketplace_tours")
}

// ═══════════════════════════════════════════════════════════════
// FACEBOOK LEAD HODISALARI — YO'QOLMAYDIGAN NAVBAT (v14)
// ═══════════════════════════════════════════════════════════════
//
// NEGA KERAK:
//   Ilgari webhook kelganda lead DARHOL, o'sha so'rov ichida qayta
//   ishlanardi. Ikkita halokatli oqibati bor edi:
//
//     1) Meta webhookdan ~5 soniyada javob kutadi. Graph API +
//        scoring + auto-reply + notification esa undan uzoq davom
//        etadi. Meta timeout deb hisoblab qayta yuboradi, ketma-ket
//        muvaffaqiyatsizlikdan keyin esa Page obunasini O'CHIRADI —
//        va hech kim buni sezmaydi.
//
//     2) Ishlov paytida istalgan xato (Graph API 500, telefon
//        dublikati, agent topilmasligi) bo'lsa — lead BUTUNLAY
//        yo'qolardi. Meta uni qayta yubormaydi.
//
// ENDI QANDAY:
//   Webhook kelishi bilan hodisa SHU JADVALGA yoziladi va Meta'ga
//   darhol 200 qaytariladi. Haqiqiy ishlov fon rejimida boradi va
//   xato bo'lsa qayta uriniladi. Hech qanday lead yo'qolmaydi.
//
//   `leadgenId` @unique — Meta bir hodisani bir necha marta yuborsa
//   ham (at-least-once kafolat) bazada bitta yozuv qoladi.
//
model FacebookLeadEvent {
  id          String    @id @default(cuid())

  /// Meta'dagi lead ID — takrorlanmas. Idempotentlikning kaliti.
  leadgenId   String    @unique

  /// Qaysi Page'dan kelgan (webhook body ichidagi entry.id)
  pageId      String

  /// Qaysi agentlikka tegishli. Page hali hech kimga ulanmagan bo'lsa null
  /// bo'lishi mumkin — yozuv baribir saqlanadi, keyin qo'lda tiklash uchun.
  tenantId    String?

  formId      String?
  adId        String?
  createdTime String?

  /// PENDING | DONE | FAILED | SKIPPED | NO_TENANT
  status      String    @default("PENDING")

  attempts    Int       @default(0)
  lastError   String?

  /// Yaratilgan mijoz (muvaffaqiyatli bo'lsa)
  clientId    String?

  /// WEBHOOK | BACKFILL — hodisa qayerdan kelgani
  source      String    @default("WEBHOOK")

  /// Graph API'dan olingan xom javob (field_data va h.k.).
  /// Backfill'da bu allaqachon to'ldirilgan bo'ladi — qayta so'rov shart emas.
  payload     Json?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([pageId])
  @@map("facebook_lead_events")
}
