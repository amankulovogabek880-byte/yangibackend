// ═══════════════════════════════════════════════════════════
// v9: APPROVAL WORKFLOW
// Chegirma, refund, muhim o'zgarishlar — admin/manager tasdiqi
// ═══════════════════════════════════════════════════════════
model ApprovalRequest {
  id           String        @id @default(cuid())
  tenantId     String

  // Kim so'ragan
  requesterId  String
  requester    User          @relation("ApprovalRequester", fields: [requesterId], references: [id])

  // Kim tasdiqlagan (yoki rad etgan)
  reviewerId   String?
  reviewer     User?         @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  type         ApprovalType
  status       ApprovalStatus @default(PENDING)

  // Bog'liq entity (Booking, Payment, Client, ...)
  entityType   String         // 'booking' | 'payment' | 'client' | 'invoice'
  entityId     String

  // Tafsilotlar
  title        String
  reason       String?        @db.Text
  oldValue     Json?          // Eski qiymat (JSON snapshot)
  newValue     Json?          // Yangi qiymat (JSON snapshot)
  amount       Float?         // Pul miqdori (chegirma/refund summasi)

  // Tasdiq/Rad
  reviewNote   String?        @db.Text
  reviewedAt   DateTime?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([requesterId])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

enum ApprovalType {
  DISCOUNT          // Chegirma
  REFUND            // Pul qaytarish
  PRICE_CHANGE      // Narx o'zgarishi
  BOOKING_CANCEL    // Booking bekor qilish
  PAYMENT_DELETE    // To'lov o'chirish
  COMMISSION_OVERRIDE // Komissiya foizini o'zgartirish
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════
// v9: BOOKING SERVICES
// Bir bookingda bir nechta xizmat (taxi, insurance, visa, sim, ...)
// Har biri o'z narxi, sanasi, statusi bilan
// ═══════════════════════════════════════════════════════════
model BookingService {
  id           String   @id @default(cuid())
  tenantId     String
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type         ServiceType
  name         String              // "Aeroport → Hotel taxi"
  description  String?  @db.Text   // To'liq tafsilot

  // Joylar va vaqt (taxi, transfer kabi)
  fromLocation String?             // "Airport"
  toLocation   String?             // "Hilton Hotel"
  date         DateTime?           // "15 July"
  time         String?             // "22:00"

  // Pul va miqdor
