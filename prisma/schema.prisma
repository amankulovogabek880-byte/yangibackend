// v9-FINAL: WEBHOOK LOGS (Audit Trail)
// Har bir public API so'rov shu yerda yoziladi
// ═══════════════════════════════════════════════════════════
model WebhookLog {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Qaysi API key ishlatildi (yo'q bo'lsa null - noma'lum key)
  apiKeyId      String?
  apiKeyPrefix  String?  // ko'rsatish uchun (omon_abc...)
  apiKeyName    String?  // ko'rsatish uchun

  // So'rov tafsilotlari
  endpoint      String   // /public/leads/...
  method        String   @default("POST")
  requestBody   Json?    // To'liq body
  responseBody  Json?    // Backend javobi
