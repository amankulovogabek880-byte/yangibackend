# ═══════════════════════════════════════════════════════════════════
# Omon TourCRM — .env shabloni
# Nusxa oling: cp .env.example .env  → so'ng haqiqiy qiymatlarni to'ldiring.
# HECH QACHON to'ldirilgan .env faylni git'ga qo'shmang (.gitignore'da bor).
# ═══════════════════════════════════════════════════════════════════

# ─── Asosiy ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Baza ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/omoncrm?schema=public"

# ─── JWT / xavfsizlik (MAJBURIY, kamida 32 belgi, tasodifiy) ────────
# Generatsiya: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-please-generate-64-char-random-secret
JWT_REFRESH_SECRET=change-me-please-generate-64-char-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Ma'lumotlarni shifrlash (telefon raqami va h.k.) — kamida 32 belgi
ENCRYPTION_KEY=change-me-please-generate-32-char-random-key

# ─── CORS (production'da MAJBURIY, '*' TAQIQLANADI) ─────────────────
CORS_ORIGINS=https://crm.example.uz,https://app.example.uz
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
FRONTEND_URL=https://crm.example.uz
PUBLIC_URL=https://api.example.uz
PUBLIC_API_URL=https://api.example.uz
API_BASE_URL=https://api.example.uz

# ─── Login himoyasi ──────────────────────────────────────────────────
MIN_PASSWORD_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=60000
REQUIRE_2FA_ADMINS=false
DETECT_FOREIGN_LOGINS=false
NOTIFY_NEW_DEVICE=false

# ─── Rate limiting (global throttler) ────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
STATIC_RATE_LIMIT=60
STATIC_RATE_WINDOW_SEC=60

# ─── Tenant izolyatsiya himoyasi ─────────────────────────────────────
# off | warn | enforce — production'da standart: enforce
TENANT_GUARD=enforce

# ─── Redis (ixtiyoriy, lekin ko'p instansda TAVSIYA ETILADI) ─────────
REDIS_URL=redis://localhost:6379

# ─── Fayllar / yuklashlar ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
UPLOADS_STRICT=true

# ─── S3 (ixtiyoriy — fayllarni bulutda saqlash uchun) ────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Supabase (ixtiyoriy, S3 o'rniga ishlatilsa) ─────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_SIGNED_URL_TTL=3600

# ─── Email (SendGrid) ─────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.uz
EMAIL_FROM_NAME="Omon CRM"

# ─── Owner / birinchi admin akkaunt ──────────────────────────────────
OWNER_EMAIL=owner@omoncrm.uz
OWNER_PASSWORD=Owner@123456!
OWNER_NAME="Owner"

# ─── Demo ma'lumotlar (faqat dev/staging uchun) ──────────────────────
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_PASSWORD=

# ─── Meta (Facebook + Instagram) ─────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=omoncrm_fb_verify
FACEBOOK_OAUTH_REDIRECT_URI=https://api.example.uz/api/v1/facebook-leads/oauth/callback
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
META_SINGLE_APP=false
META_WEBHOOK_SKIP_SIGNATURE=false
LEAD_SLA_MINUTES=15

# ─── Telefoniya webhooklari ───────────────────────────────────────────
PHONE_WEBHOOK_SECRET=change-me-random-secret
WHATSAPP_WEBHOOK_SECRET=change-me-random-secret

# ─── Telegram (shaxsiy akkaunt, MTProto) ─────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_NOTIFY_BOT_TOKEN=

# ─── Tur qidiruv / marketplace ────────────────────────────────────────
RATEHAWK_ENV=test
RATEHAWK_INFO_LIMIT=50
RATEHAWK_NAME_CACHE_HOURS=24
MARKETPLACE_OPERATORS_JSON=

# ─── AI / tashqi API kalitlari (ixtiyoriy) ───────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ─── Backup ────────────────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_CRON="0 3 * * *"

# ─── Loglash ──────────────────────────────────────────────────────────
LOG_DIR=./logs

# ─── Hisobotlar ────────────────────────────────────────────────────────
MAX_REPORT_RANGE_DAYS=365

# ─── Swagger (API docs) ────────────────────────────────────────────────
# Production'da standart: yopiq. Ochish uchun aniq true qo'ying.
SWAGGER_ENABLED=false

# ─── Boshqa ────────────────────────────────────────────────────────────
FFMPEG_PATH=
TEMP=/tmp
